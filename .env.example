# Supabase → Project Settings → API (use the publishable key, NEVER the secret/service key)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public URL of the deployed web app (used in invite links and calendar events).
# Leave empty while developing; invite links then use the app's deep-link scheme.
EXPO_PUBLIC_APP_URL=
